# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."
VITE_SUPABASE_PROJECT_ID="xxxx"

# ─── ZeptoMail ───────────────────────────────────────────────────────────────
# Token copiado do painel ZeptoMail > "Send Mail Token" (inclui o prefixo "Zoho-enczapikey ")
ZEPTOMAIL_TOKEN="Zoho-enczapikey XXXXXXXXXXXXXXXXXXXXXXXX"

# Endereço de remetente verificado no ZeptoMail
ZEPTOMAIL_FROM_ADDRESS="noreply@seudominio.com"

# Nome de exibição do remetente
ZEPTOMAIL_FROM_NAME="Agendamentos JS"

# ─── App ─────────────────────────────────────────────────────────────────────
# URL pública da aplicação (sem barra no final) — usada nos links de cancelamento
PUBLIC_BASE_URL="https://app.seudominio.com"

# ─── Segurança ───────────────────────────────────────────────────────────────
# Segredo compartilhado entre o cron do Supabase e o endpoint de lembrete.
# O cron envia no header "x-cron-secret"; o endpoint recusa quem não tiver.
# Se ficar vazio, o endpoint segue aberto (sem proteção).
REMINDER_SECRET=""

# Proteção anti-robô (Cloudflare Turnstile) no formulário de agendamento.
# Crie um widget em Cloudflare > Turnstile. A site key é pública (vai no front),
# a secret key fica só no servidor. Se ficarem vazias, a proteção é desligada.
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
